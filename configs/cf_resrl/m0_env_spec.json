{
  "base": "cuda12.8 + python3.10",
  "system_pkgs": [
    "git",
    "ffmpeg>=7,<8"
  ],
  "pip_phases": [
    [
      "torch==2.7.1",
      "torchvision==0.22.1",
      "--index-url",
      "https://download.pytorch.org/whl/cu128"
    ],
    [
      "gymnasium==1.1.1",
      "mujoco==3.3.2",
      "mink==0.0.7",
      "huggingface-hub==0.36.0",
            "pyarrow==19.0.1",
            "--index-url",
            "https://pypi.org/simple"
    ],
    [
      "-e",
            "third_party/robosuite",
            "--index-url",
            "https://pypi.org/simple"
    ]
  ],
  "env": {
    "MUJOCO_GL": "egl",
        "PYTHONPATH": "third_party/resfit",
        "PYTHONNOUSERSITE": "1"
  },
  "run_commands": [
    "bash scripts/setup_m0_env.sh"
  ],
  "weight_dirs": {},
  "smoke": {
    "import_names": [
      "torch",
      "gymnasium",
      "mujoco",
      "robosuite",
      "huggingface_hub",
      "pyarrow",
      "resfit.dexmg.environments.dexmg"
    ],
    "gpu_tests": [
      {
        "cmd": "python -c 'import torch; torch.manual_seed(0); x=torch.randn(8,8,device=\"cuda\"); y=x@x; print(\"WITNESS\", tuple(y.shape), torch.cuda.get_device_name(), float(y.sum()))'",
        "expect": "^WITNESS \\(8, 8\\) "
      }
    ],
    "cli_checks": [
      "nvidia-smi",
      "ffmpeg -version",
      "ffprobe -version"
    ]
  }
}
