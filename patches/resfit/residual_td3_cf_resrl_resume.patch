@@ -129,3 +129,25 @@ def save_checkpoint(
 
     torch.save(checkpoint_data, checkpoint_path)
     print(f"💾 Saved checkpoint to: {checkpoint_path}")
+
+
+def load_checkpoint(agent: QAgent, checkpoint_path: str | Path, map_location: str | torch.device = "cpu") -> dict:
+    """Load evaluation weights and saved optimizer metadata into an initialized QAgent.
+
+    The returned extras do not include replay buffers or live environment state, so
+    this is not a complete training-resume operation.
+    """
+    checkpoint = torch.load(checkpoint_path, map_location=map_location, weights_only=False)
+    agent.load_state_dict(checkpoint["agent_state_dict"])
+
+    optimizer_state = checkpoint["optimizer_state_dict"]
+    agent.actor_opt.load_state_dict(optimizer_state["actor_opt"])
+    agent.critic_opt.load_state_dict(optimizer_state["critic_opt"])
+    agent.encoder_opt.load_state_dict(optimizer_state["encoder_opt"])
+
+    scheduler_state = checkpoint.get("scheduler_state_dict", {})
+    for name in ("actor_scheduler", "critic_scheduler", "encoder_scheduler"):
+        scheduler = getattr(agent, name, None)
+        if scheduler is not None and name in scheduler_state:
+            scheduler.load_state_dict(scheduler_state[name])
+    return checkpoint
